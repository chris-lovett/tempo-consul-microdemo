# deploy/ec2/terraform/terraform.tfvars.example
#
# Copy to terraform.tfvars and fill in secrets before running terraform apply.
# DO NOT commit terraform.tfvars — it is gitignored.
#
# Get consul_license from:
#   kubectl get secret -n consul license -o jsonpath='{.data.key}' | base64 -d
#
# mgw_token is generated fresh each deploy by user_data.sh.tpl.
# After apply, find it at /etc/vm-dc-tokens.env on the VM.

aws_region        = "us-east-2"
subnet_id         = "subnet-0f6c842e85b144619"
security_group_id = "sg-0b12e1b96649e7a18"
instance_type     = "t3.medium"
key_name          = "vm-dc-demo"

consul_license = "PASTE_LICENSE_HERE"

# consul_expose_servers_elb and otelcol_route_url have working defaults in variables.tf

# ACL tokens — defaults in variables.tf match the existing vm-dc tokens.
# Only override if you rotated them.
# bootstrap_token = "..."
# web_token       = "..."

# mgw_token is required — a placeholder value; user_data generates the real one
mgw_token = "placeholder-replaced-at-boot"
